# Copy to .env and fill in before running `docker compose up`.

# Convex self-hosted backend
INSTANCE_NAME=wavelink_local
# Generate with: openssl rand -hex 32
INSTANCE_SECRET=
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
DO_NOT_REQUIRE_SSL=true

# Postgres (only used with --profile production)
# POSTGRES_DB must equal INSTANCE_NAME above with hyphens -> underscores —
# the backend connects to a database named after INSTANCE_NAME and expects
# it to already exist. postgres:17-alpine creates it automatically on first
# boot (fresh volume only) via POSTGRES_DB. If you change INSTANCE_NAME after
# the volume already exists, either reset the volume or create the database
# manually: psql $POSTGRES_URL -c "CREATE DATABASE <name>;"
POSTGRES_USER=convex
POSTGRES_PASSWORD=
POSTGRES_DB=wavelink_local
# Must NOT include a database name or query params (Convex requires this).
POSTGRES_URL=postgres://convex:<password>@postgres:5432

# Simulator (optional, --profile simulator)
SIMULATOR_INTERVAL_MS=2000
