# Copy to .env and fill in before running `docker compose up`.

# Convex self-hosted backend
INSTANCE_NAME=wavelink_local
# Generate with: openssl rand -hex 32
INSTANCE_SECRET=
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
DO_NOT_REQUIRE_SSL=true

# Postgres (only used with --profile production)
# POSTGRES_DB must equal INSTANCE_NAME above with hyphens -> underscores —
# the backend connects to a database named after INSTANCE_NAME and expects
# it to already exist. postgres:17-alpine creates it automatically on first
# boot (fresh volume only) via POSTGRES_DB. If you change INSTANCE_NAME after
# the volume already exists, either reset the volume or create the database
# manually: psql $POSTGRES_URL -c "CREATE DATABASE <name>;"
POSTGRES_USER=convex
POSTGRES_PASSWORD=
POSTGRES_DB=wavelink_local
# Must NOT include a database name or query params (Convex requires this).
POSTGRES_URL=postgres://convex:<password>@postgres:5432

# Auth (set on the Convex deployment; see README "Authentication").
# First admin: the ONE email allowed to run the bootstrap while no users exist.
INITIAL_ADMIN_EMAIL=admin@example.com

# Ingestion (telemetry-ingestion) — required for any telemetry to be
# accepted; a deployment with this unset or empty refuses all ingestion
# (there is no usable default baked into the build). Comma-separated
# <sourceId>.<secret> entries, e.g. "simulator.<secret>". Generate a secret
# with: openssl rand -hex 24
# To rotate: add a second entry with the same sourceId as the old one, wait
# for senders to switch, then remove the old entry — no gap, no restart.
INGEST_TOKENS=
# See docker-compose.yml: the `push` service reads INGEST_TOKENS above and
# runs `npx convex env set` so it lands as a *deployment* env var (not this
# container's env) — see README's Ingestion section for why that split
# matters on self-hosted Convex.

# Tunable ingestion limits (all optional — every one has a built-in default;
# uncomment and change only the ones you need to override). See README's
# Ingestion section for what each does and why the default was chosen.
# INGEST_MAX_READINGS_PER_BATCH=500
# INGEST_MAX_PAYLOAD_BYTES=1048576
# INGEST_MAX_FUTURE_SKEW_MS=120000
# INGEST_MAX_BACKFILL_AGE_MS=604800000
# INGEST_MAX_EXTERNAL_ID_LENGTH=128
# INGEST_MAX_METRIC_LENGTH=64
# INGEST_MAX_STRING_VALUE_LENGTH=512
# INGEST_REQUESTS_PER_MINUTE=120
# INGEST_REQUEST_BURST=60
# INGEST_READINGS_PER_MINUTE=6000
# INGEST_READING_BURST=3000
# INGEST_REJECTION_RETENTION_MS=604800000
# INGEST_REJECTION_MAX_ROWS=200000
# INGEST_STATS_RETENTION_MS=7776000000

# Simulator (optional, --profile simulator)
SIMULATOR_INTERVAL_MS=2000
# Must be exactly one of the "<sourceId>.<secret>" entries from INGEST_TOKENS
# above — the simulator authenticates ingestion with it.
WAVELINK_INGEST_TOKEN=
# Max readings the simulator puts in one ingestion request; must not exceed
# INGEST_MAX_READINGS_PER_BATCH above.
WAVELINK_MAX_BATCH=50

# Device registry — these are NOT docker-compose/container env vars. They are
# Convex deployment (function) env vars, set with `npx convex env set <NAME> <VALUE>`
# (or the dashboard's "Settings > Environment Variables"), because that is
# where `process.env` inside a Convex function reads from — the self-hosted
# backend's own env store, independent of this file. Listed here only for
# discoverability; see README "Environment variables" for defaults and effect.
#   DEVICE_HEARTBEAT_WINDOW_MS
#   DEVICE_METADATA_MAX_ENTRIES
#   DEVICE_METADATA_MAX_KEY_LENGTH
#   DEVICE_METADATA_MAX_VALUE_LENGTH
#   DEVICE_LIST_PAGE_SIZE
